DISCORD_TOKEN=your_bot_token_here
DISCORD_CLIENT_ID=your_application_client_id_here

# Optional: set this while developing so slash command updates are instant.
# Leave empty for global commands. Global command updates can take up to an hour.
DISCORD_GUILD_ID=

# Optional: YouTube cookie string for better YouTube playback reliability.
# Keep this secret. Do not commit your real cookie value.
YOUTUBE_COOKIE=

# Optional and preferred for yt-dlp playback: path to a Netscape cookies.txt file.
# Example on the droplet: /opt/stupider-discord-bot/youtube.cookies.txt
YOUTUBE_COOKIES_FILE=
