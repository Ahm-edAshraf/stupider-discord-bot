DISCORD_TOKEN=your_bot_token_here
DISCORD_CLIENT_ID=your_application_client_id_here

# Optional: set one or more guild IDs while developing so slash command updates are instant.
# Use DISCORD_GUILD_IDS for multiple servers, comma-separated.
# Leave both empty for global commands. Global command updates can take up to an hour.
DISCORD_GUILD_ID=
DISCORD_GUILD_IDS=

# Optional: YouTube cookie string for better YouTube playback reliability.
# Keep this secret. Do not commit your real cookie value.
YOUTUBE_COOKIE=

# Optional and preferred for yt-dlp playback: path to a Netscape cookies.txt file.
# Example on the droplet: /opt/stupider-discord-bot/youtube.cookies.txt
YOUTUBE_COOKIES_FILE=

# Optional: used by `bun run sync:cookies` to copy a local cookies file to the droplet.
STUPIDER_DROPLET_HOST=
STUPIDER_DROPLET_USER=root
STUPIDER_REMOTE_APP_DIR=/opt/stupider-discord-bot
STUPIDER_REMOTE_COOKIES_FILE=/opt/stupider-discord-bot/youtube.cookies.txt

# Optional: AI chat mode. Requires Message Content Intent in the Discord Developer Portal.
AI_ENABLED=false
GROQ_API_KEY=
AI_MODEL=llama-3.1-8b-instant
AI_DB_PATH=./data/ai.sqlite
AI_DAILY_REPLY_CAP_PER_GUILD=300
AI_MAX_RECENT_MESSAGES=12
AI_MAX_OUTPUT_TOKENS=64
AI_GLOBAL_DAILY_TOKEN_CAP=450000
AI_MAX_MESSAGE_LENGTH=1000
AI_MESSAGE_RETENTION_DAYS=30
